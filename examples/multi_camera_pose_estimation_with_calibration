class ray:
    def __init__(self,origin,direction):
        self.origin = origin
        self.direction = direction/np.linalg.norm(direction)

def triangulate(rays: list[ray]):
    """
    Solve the quadratic programming problem:
        minimize (1/2) x^T P x + q^T x
        subject to A x = b
                   G x <= h
                   lb <= x <= ub    
    Args:        rays: list of rays, each ray is defined by an origin and a direction
    Returns:        x: Solution vector (3,) the triangulated position
                    errors: list of errors for each ray, the distance from the triangulated position to the ray
    """
    R = np.zeros((len(rays),3,3+len(rays)))
    P = np.zeros((3+len(rays),3+len(rays)))
    q = np.zeros((3+len(rays),))
    for i in range(len(rays)):
        R[i][0:3,0:3] = np.eye(3)
        R[i][0:3,3+i] = -rays[i].direction   
        P += R[i].T @ R[i]
        q += -R[i].T @ rays[i].origin

    problem = Problem(P, q)
    solution = solve_problem(problem, solver="clarabel")
    # Use the OSQP solver as an example. You can choose any other solver available in qpsolvers.
    if (solution.x is None):
        logger.warning("QP solver failed to find a solution.")
        return None,None   
    
    errors = []
    for i in range(len(rays)):
        error = np.linalg.norm(R[i] @ solution.x - rays[i].origin)
        errors.append(error)
  
    
    return solution.x[0:3],errors
    
def calibrate(camera: EmioCamera, marker_position_dic: dict[int, np.ndarray]):
    # ArUco marker detection setup
    aruco_dict = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_ARUCO_ORIGINAL)
    parameters = cv2.aruco.DetectorParameters()
    detector = cv2.aruco.ArucoDetector(aruco_dict, parameters)
    
    intrinsics = camera._camera.intr    
    camera_matrix = np.array([
        [intrinsics.fx, 0, intrinsics.ppx],
        [0, intrinsics.fy, intrinsics.ppy],
        [0, 0, 1]
    ], dtype=np.float32)
    dist_coeffs = np.zeros((4, 1))

    marker_size = 70
    for i in range(100): # wait the auto exposure to adjust
        ret, color_frame, depth_frame, depth_rsframe = camera._camera.get_frame()
    gray = cv2.cvtColor(color_frame, cv2.COLOR_BGR2GRAY)
    _,thresh_image = cv2.threshold(gray,95,255,cv2.THRESH_TOZERO)
    image = thresh_image
            # Detect ArUco markers
    corners, ids, rejected = detector.detectMarkers(thresh_image)
    if ids is None or len(ids) == 0:
        logger.warning(f"No ArUco markers detected for camera {camera.camera_serial}. Calibration failed.")
        return
    success = False
    rvec = None
    tvec = None
    obj_points = np.empty((0,3), dtype=np.float32)
    obj_corners = np.empty((0,2), dtype=np.float32)

    for i in range(len(ids)):
        id = int(ids[i][0])
        # 3D object points of marker corners

        if id in marker_position_dic.keys():
            marker_position = marker_position_dic[id]
            obj_points = np.vstack([obj_points, np.array([
                [-marker_size/2, marker_size/2, 0],
                [marker_size/2, marker_size/2, 0],
                [marker_size/2, -marker_size/2, 0],
                [-marker_size/2, -marker_size/2, 0]
            ], dtype=np.float32) + marker_position])

            obj_corners = np.vstack([obj_corners, [corners[i][0][j] for j in range(4)]])
            logger.info(f"Camera {camera.camera_serial} detected marker {id} at position {marker_position}.")

        
    if len(obj_points) > 0:
        
        success, rvec, tvec = cv2.solvePnP(
            obj_points,
            obj_corners,
            camera_matrix,
            dist_coeffs,
        )
    if success and rvec is not None and tvec is not None:
        rotation_matrix, _ = cv2.Rodrigues(rvec)
        # location of the camera in the marker reference frame is given by -R^T * tvec
        camera_position = -rotation_matrix.T @ tvec.flatten()
        # camera orientation in the marker reference frame is given by R^T
        camera_orientation = rotation_matrix.T

        camera._camera.position_estimator.R = camera_orientation
        camera._camera.position_estimator.t = camera_position
        logger.debug(f"Camera {camera.camera_serial} position estimator set with R:\n{rotation_matrix.T}\nt:\n{camera_position}")
    logger.info(f"Camera {camera.camera_serial} calibrated.")


def create_marker_position_dictionary():
    # Create a dictionary to store the positions of the markers
    marker_positions = {
        672: np.array([0, 0, 0]),  # Marker ID 672 at the origin
        42: np.array([84, 0, 0]),  # Marker ID 42 at (84mm, 0, 0)
        # Add more markers here if needed
    }
    return marker_positions

def main(cameras: list[EmioCamera]):
    logger.info("Calibrating cameras...")
    threads = []
    start_time = time.time()
    marker_position_dic = create_marker_position_dictionary()
    
    for camera in cameras:
        thread = threading.Thread(target=calibrate, args=(camera,marker_position_dic))
        threads.append(thread)
        thread.start()
        #calibrate(camera,marker_position_dic)


    for thread in threads:
        thread.join()
    logger.info(f"Calibration completed in {time.time() - start_time:.2f} seconds.")
    input("Press Enter to start pose estimation...")
    while cameras[0].is_running:  # Assuming all cameras have the same running state
