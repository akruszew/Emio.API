            logger.info(f"Trackers positions Camera 1: {np.round(emio.trackers_pos, decimals=2)}")
            logger.info(f"Trackers positions Camera 2: {np.round(emio2.trackers_pos, decimals=2)}")
            
            x = emio._trackers_pos_camera_image[0][0]
            y = emio._trackers_pos_camera_image[0][1]
            ray_world_1 = np.array([emio._camera.position_estimator.camera_image_to_simulation(x, y, 1.0) - emio._camera.position_estimator.t])
            camera_pos_world = emio._camera.position_estimator.t
            q1 = np.array([emio._camera.position_estimator.t])
            
            x = emio2._trackers_pos_camera_image[0][0]
            y = emio2._trackers_pos_camera_image[0][1]
            ray_world_2 = np.array([emio2._camera.position_estimator.camera_image_to_simulation(x, y, 1.0) - emio2._camera.position_estimator.t])
            camera_pos_world_2 = emio2._camera.position_estimator.t
            q2 = np.array([emio2._camera.position_estimator.t])
            
            estimation1,estimation2 = solve_qp(ray_world_1.T,ray_world_2.T,q1.T,q2.T)
            logger.info(f"Trackers positions Camera 1: {np.round(estimation1.T, decimals=2)}")
            logger.info(f"Trackers positions Camera 2: {np.round(estimation2.T, decimals=2)}")
            estimation3 = solve_qp_global(ray_world_1.T,ray_world_2.T,q1.T,q2.T)
            logger.info(f"Trackers positions Camera  : {np.round(estimation3.T, decimals=2)}")

    

            time.sleep(0.1)
        except KeyboardInterrupt:
            logger.info("Keyboard interrupt received.")
            break
        except Exception as e:
            logger.exception(f"Error during communication: {e}")
            break


