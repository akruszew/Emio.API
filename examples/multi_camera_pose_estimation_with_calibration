def solve_qp(r1,r2,q1,q2):
    """
    Solve the quadratic programming problem:
        minimize (1/2) x^T P x + q^T x
        subject to A x = b
                   G x <= h
                   lb <= x <= ub

    Args:
        P: Quadratic coefficient matrix (n x n)
        q: Linear coefficient vector (n,)
        A: Equality constraint matrix (m x n)
        b: Equality constraint vector (m,)
        G: Inequality constraint matrix (p x n)
        h: Inequality constraint vector (p,)
        lb: Lower bound vector (n,)
        ub: Upper bound vector (n,)

    Returns:
        x: Solution vector (n,)
    """
    R = np.hstack((r1,-r2))
    P = R.T @ R
    q = R.T @ (q1 - q2)
    
    A=None
    b=None
    G=None
    h=None
    lb=None
    ub=None
    problem = Problem(P, q, G, h, A, b, lb, ub)
    solution = solve_problem(problem, solver="clarabel")
    # Use the OSQP solver as an example. You can choose any other solver available in qpsolvers.
    s1 = solution.x[0]
    s2 = solution.x[1]
    return r1*s1+q1,r2*s2+q2

def solve_qp_global(r1,r2,q1,q2):
    """
    Solve the quadratic programming problem:
        minimize (1/2) x^T P x + q^T x
        subject to A x = b
                   G x <= h
                   lb <= x <= ub

    Args:
        P: Quadratic coefficient matrix (n x n)
        q: Linear coefficient vector (n,)
        A: Equality constraint matrix (m x n)
        b: Equality constraint vector (m,)
        G: Inequality constraint matrix (p x n)
        h: Inequality constraint vector (p,)
        lb: Lower bound vector (n,)
        ub: Upper bound vector (n,)

    Returns:
        x: Solution vector (n,)
    """
    z = np.zeros_like(r1)
    R1 = np.hstack((np.eye(3),-r1,z))
    R2 = np.hstack((np.eye(3),z,-r2))
    
    P = R1.T @ R1 + R2.T @ R2
    q = -R1.T @ q1 - R2.T @ q2
    A=None
    b=None
    G=None
    h=None
    lb=None
    ub=None
    problem = Problem(P, q, G, h, A, b, lb, ub)
    solution = solve_problem(problem, solver="clarabel")
    # Use the OSQP solver as an example. You can choose any other solver available in qpsolvers.
    qa = solution.x[0:3]
    
    return qa 


def main(emio: EmioCamera,emio2: EmioCamera):

    emio.calibrate()  # calibrate the camera if needed
    emio2.calibrate()  # calibrate the camera if needed

    while emio.is_running:
        try:
            emio.update() # update the camera frame and trackers
            emio2.update() # update the camera frame and trackers

            print("-"*20)
